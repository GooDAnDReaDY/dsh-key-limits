{
  "name": "@goodandready-private/dsh-key-limits",
  "version": "0.1.3",
  "description": "DeepSeek Harness plugin: API key / subscription quota limits (float chip, composer bar, settings).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "quota",
    "limits",
    "api-key"
  ],
  "author": "GoodAndReady",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodandready-private/dsh-key-limits.git"
  },
  "bugs": {
    "url": "https://github.com/goodandready-private/dsh-key-limits/issues"
  },
  "homepage": "https://github.com/goodandready-private/dsh-key-limits#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test",
    "prepublishOnly": "npm run build:client && node --test",
    "smoke": "bash scripts/smoke-staging.sh",
    "deploy:staging": "bash scripts/deploy-staging.sh"
  }
}
